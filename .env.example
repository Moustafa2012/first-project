# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never expose to the browser or commit. Needed for: private document storage and the
# doctor-side share viewer (share_open / share_bundle are callable by service_role only).
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL used to build share links, e.g. https://shifa.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Long random string. Salts the hash of client IP addresses stored in share access logs.
# Generate with: openssl rand -base64 32
SHARE_HASH_SALT=
